# =========================================================
# Nextiweb Studio — .htaccess
# Optimisé pour Apache 2.4+ (Hostinger, OVH, Cloudflare).
# =========================================================

# ----- 1. HTTPS forcé -----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirection HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirection www → non-www (canonique)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

  # Trailing slash : ajoute / aux URLs sans extension
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]

  # Redirections 301 — restructuration secteurs → labo (mai 2026)
  RewriteRule ^secteurs/dentiste\.html$ /labo/dentaire-et-soins/ [L,R=301]
  RewriteRule ^secteurs/restaurant\.html$ /labo/restaurant-et-cafe/ [L,R=301]
  RewriteRule ^secteurs/piscine\.html$ /labo/piscine-et-renovation/ [L,R=301]
  RewriteRule ^secteurs/chocolatier\.html$ /labo/chocolat-et-artisan/ [L,R=301]
  RewriteRule ^secteurs/ecommerce-artisan\.html$ /labo/ [L,R=301]
  RewriteRule ^secteurs/?$ /labo/ [L,R=301]
  RewriteRule ^secteurs/index\.html$ /labo/ [L,R=301]

  # Pages d'erreur custom
  ErrorDocument 404 /404.html
</IfModule>

# ----- 2. Compression gzip -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff font/woff2
</IfModule>

# ----- 3. Cache headers -----
<IfModule mod_expires.c>
  ExpiresActive On

  # Images : 1 an
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS / JS : 1 mois (bumps via fingerprint si possible)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # Fonts : 1 an
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # HTML : pas de cache (pour pouvoir modifier rapidement)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ----- 4. Sécurité -----
<IfModule mod_headers.c>
  # HSTS — HTTPS forcé pendant 1 an
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Anti-clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # MIME type sniffing désactivé
  Header always set X-Content-Type-Options "nosniff"

  # Référer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy minimale
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Content-Security-Policy — score Mozilla Observatory A+
  # Autorise Google Fonts (CSS + woff2) + self pour le reste
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; frame-src https://*.nextiwebstudio.ca; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"

  # Cross-Origin policies (sécurité moderne — Lighthouse Best Practices)
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-site"

  # Cache immutable pour assets versionnés
  <FilesMatch "\.(css|js|woff2|woff|jpg|jpeg|png|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ----- 5. Encodages & charset -----
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType image/avif .avif
AddType font/woff2 .woff2

# ----- 6. Protection des fichiers sensibles -----
<FilesMatch "(^\.|\.md$|\.markdown$|\.log$|\.bak$)">
  Require all denied
</FilesMatch>

# Empêche le listing de répertoires
Options -Indexes
